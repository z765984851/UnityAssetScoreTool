<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Tools/asset_score_tool/Editor/UI/ScanWindow/ScanWindow.uss?fileID=7433441132597879392&amp;guid=c3a9d48021bc4594e8cfa2e738640996&amp;type=3#ScanWindow"/>
    <Style src="../Common/Common.uss"/>
    <ui:VisualElement name="Root" style="flex-grow: 1;">
        <ui:VisualElement name="PageHeader"
                          class="page-header-view">
            <ui:VisualElement name="PageHeaderHeading"
                              class="page-header-heading">
                <ui:Label name="PageHeaderTitle"
                          class="page-header-title"
                          text="Asset Score Tool"/>
                <ui:Label name="PageHeaderDescription"
                          class="page-header-description"
                          text="扫描资源质量、规则命中情况和依赖关系。"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TopInputArea"
                          class="scan-top-input"
                          style="flex-grow: 0;">
            <ui:VisualElement name="ProfileRow"
                              class="scan-top-input-row scan-top-input-profile-row"
                              style="flex-grow: 0; flex-direction: row; align-items: center;">
                <ui:DropdownField label="Profile" name="ProfileDropdown"
                                  class="scan-top-input-control"
                                  style="flex-grow: 1; flex-shrink: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="PathRow"
                              class="path-input-row scan-top-input-row scan-top-input-path-row"
                              style="flex-grow: 0; flex-direction: row; align-items: center;">
                <ui:TextField picking-mode="Ignore" label="检测路径" name="PathTextField"
                              class="path-input-text scan-top-input-control"
                              style="flex-grow: 1; flex-shrink: 1;"/>
                <ui:Button text="选择文件夹" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="SelectFolderButton"
                           class="path-input-browse-button"/>
                <ui:Button text="选择文件" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="SelectFileButton"
                           class="path-input-browse-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="ScanActionRow" style="flex-grow: 0; flex-direction: row; align-items: center;">
                <ui:VisualElement name="Space"
                                  style="flex-grow: 0; flex-direction: column; width: 120px; flex-shrink: 0;"/>
                <ui:Button text="开始评分" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="StartScanButton" style="width: 160px; height: 28px; align-items: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ExportRow" style="flex-grow: 0; flex-direction: row; align-items: center;">
                <ui:VisualElement name="Space"
                                  style="flex-grow: 0; flex-direction: column; width: 120px; flex-shrink: 0;"/>
                <ui:Button text="导出 Json" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="ExportJsonButton" style="flex-grow: 0; width: 120px;"/>
                <ui:Button text="导出 Excel" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="ExportExcelButton" style="flex-grow: 0; width: 120px;"/>
                <ui:Button text="打开导出目录" parse-escape-sequences="true" display-tooltip-when-elided="true"
                           name="OpenExportFolderButton" style="flex-grow: 0; width: 120px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainContentArea"
                          class="scan-main-content"
                          style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="ResultListPanel"
                              class="scan-result-panel">
                <ui:Label tabindex="-1" text="检测结果" parse-escape-sequences="true" display-tooltip-when-elided="true"
                          name="ResultListTitleLabel" class="scan-panel-title" enable-rich-text="true"/>
                <ui:VisualElement name="FilterBar"
                                  class="scan-filter-bar"
                                  style="flex-grow: 0; flex-direction: row; align-items: center;">
                    <ui:DropdownField label="类型" name="AssetTypeFilterDropdown" class="scan-filter-control"/>
                    <ui:DropdownField label="严重度筛选" name="SeverityFilterDropdown"
                                      class="scan-filter-control"/>
                    <ui:DropdownField label="排序" name="SortDropdown" class="scan-filter-control"/>
                </ui:VisualElement>
                <ui:VisualElement name="ResultHeaderRow"
                                  class="scan-result-header-row"
                                  style="flex-grow: 0; flex-direction: row; align-items: center;">
                    <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true"
                              name="HeaderExpandLabel" class="scan-result-header-expand" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="资源名" parse-escape-sequences="true"
                              display-tooltip-when-elided="true" name="HeaderNameLabel"
                              class="scan-result-header-name" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="类型" parse-escape-sequences="true" display-tooltip-when-elided="true"
                              name="HeaderTypeLabel" class="scan-result-header-type" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="分数" parse-escape-sequences="true" display-tooltip-when-elided="true"
                              name="HeaderScoreLabel" class="scan-result-header-score" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="等级" parse-escape-sequences="true" display-tooltip-when-elided="true"
                              name="HeaderGradeLabel" class="scan-result-header-grade" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="最高严重度" parse-escape-sequences="true"
                              display-tooltip-when-elided="true" name="HeaderSeverityLabel"
                              class="scan-result-header-severity" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="问题数" parse-escape-sequences="true"
                              display-tooltip-when-elided="true" name="HeaderIssueCountLabel"
                              class="scan-result-header-issue-count" enable-rich-text="true"/>
                    <ui:Label tabindex="-1" text="路径" parse-escape-sequences="true" display-tooltip-when-elided="true"
                              name="HeaderPathLabel" class="scan-result-header-path" enable-rich-text="true"/>
                </ui:VisualElement>
                <ui:ScrollView name="ResultScrollView"
                               class="scan-result-scroll"
                               mode="VerticalAndHorizontal"
                               horizontal-scroller-visibility="Auto"
                               vertical-scroller-visibility="Auto"
                               style="flex-grow: 1;"/>
            </ui:VisualElement>
            <ui:VisualElement name="DetailPanel"
                              class="scan-detail-panel">
                <ui:Label tabindex="-1" text="资源详情" parse-escape-sequences="true" display-tooltip-when-elided="true"
                          name="DetailTitleLabel" class="scan-panel-title" enable-rich-text="true"/>
                <ui:ScrollView name="DetailScrollView"
                               class="scan-detail-scroll"
                               mode="Vertical"
                               vertical-scroller-visibility="Auto"
                               horizontal-scroller-visibility="Hidden"
                               style="flex-grow: 1;">
                    <ui:VisualElement name="DetailActionRow"
                                      class="object-reference-actions scan-detail-action-row">
                        <ui:Button text="在编辑器内选中" parse-escape-sequences="true"
                                   display-tooltip-when-elided="true"
                                   name="PingMainAssetButton"
                                   class="object-reference-action-button object-reference-select-button"/>
                        <ui:Button text="打开所在文件夹" parse-escape-sequences="true"
                                   display-tooltip-when-elided="true"
                                   name="OpenFolderButton"
                                   class="object-reference-action-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="DetailInfoContainer" class="scan-detail-info">
                        <ui:Label tabindex="-1" text="资源名：未选择" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailAssetNameLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="路径：-" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailAssetPathLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="类型：-" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailAssetTypeLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="Profile：-" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailProfileLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="分数：-" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailScoreLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="等级：-" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailGradeLabel" class="scan-detail-info-label"/>
                        <ui:Label tabindex="-1" text="问题数：0" parse-escape-sequences="true"
                                  display-tooltip-when-elided="true" name="DetailIssueCountLabel" class="scan-detail-info-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="IssueFoldoutHost"
                                      class="scan-detail-foldout-host"/>
                    <ui:VisualElement name="DependencyFoldoutHost"
                                      class="scan-detail-foldout-host"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomStatusBar"
                          class="scan-status-bar"
                          style="flex-grow: 0; flex-direction: row;">
            <ui:Label tabindex="-1" text="进度：" parse-escape-sequences="true" display-tooltip-when-elided="true"
                      name="ScanStatusLabel" class="scan-status-text" enable-rich-text="true"/>
            <ui:ProgressBar value="22" title="检测进度" name="ScanProgressBar" class="scan-progress-bar"/>
            <ui:Label tabindex="-1" text="耗时：0 ms" parse-escape-sequences="true" display-tooltip-when-elided="true"
                      name="ScanTimeLabel" class="scan-status-text" enable-rich-text="true"/>
            <ui:Label tabindex="-1" text="显示资源：0" parse-escape-sequences="true" display-tooltip-when-elided="true"
                      name="VisibleCountLabel" class="scan-status-text" enable-rich-text="true"/>
            <ui:Label tabindex="-1" text="问题总数：0" parse-escape-sequences="true" display-tooltip-when-elided="true"
                      name="IssueCountLabel" class="scan-status-text" enable-rich-text="true"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
