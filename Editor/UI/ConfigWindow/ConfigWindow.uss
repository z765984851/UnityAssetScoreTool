    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 73, 82);
    border-right-color: rgb(65, 73, 82);
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
    border-radius: 5px;
    background-color: rgb(23, 26, 30);
    color: rgb(237, 241, 245);
}

.white-list-path-actions {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.white-list-path-button {
    min-width: 76px;
    margin-right: 4px;
}

.white-list-path-button:last-child {
    min-width: 88px;
    margin-right: 0;
}

.multiline-text-field {
    min-height: 84px;
    margin-bottom: 16px;
}

.rule-apply-item-subsection {
    min-width: 0;
    margin-top: 18px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(57, 65, 74);
}

.rule-apply-item-subsection-first {
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
}

.rule-apply-item-subsection-divider {
    border-top-width: 1px;
    border-top-color: rgb(57, 65, 74);
}

.rule-reference-content {
    min-width: 0;
}

.subsection-title {
    margin-bottom: 9px;
    color: rgb(203, 211, 220);
    font-size: 14px;
}

.rule-reference-content .reference-form-row {
    margin-bottom: 0;
}

.config-reference-chip {
    min-height: 27px;
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    margin-right: 6px;
    padding-left: 10px;
    padding-right: 2px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 14px;
    background-color: rgb(42, 49, 56);
}

.config-reference-chip-asset-type {
    border-left-color: rgb(69, 111, 158);
    border-right-color: rgb(69, 111, 158);
    border-top-color: rgb(69, 111, 158);
    border-bottom-color: rgb(69, 111, 158);
    background-color: rgb(37, 59, 82);
}

.config-reference-chip-profile {
    border-left-color: rgb(112, 93, 145);
    border-right-color: rgb(112, 93, 145);
    border-top-color: rgb(112, 93, 145);
    border-bottom-color: rgb(112, 93, 145);
    background-color: rgb(54, 47, 70);
}

.config-reference-chip-label {
    margin-right: 3px;
    color: rgb(208, 216, 224);
    font-size: 12px;
}

.config-reference-chip-asset-type .config-reference-chip-label {
    color: rgb(169, 210, 245);
}

.config-reference-chip-profile .config-reference-chip-label {
    color: rgb(208, 189, 240);
}

.config-reference-chip-remove {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-left: 1px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    background-color: transparent;
    color: rgb(201, 211, 221);
    font-size: 14px;
}

.multiline-text-field .unity-base-text-field__input,
.multiline-text-field .unity-text-field__input {
    min-height: 84px;
    padding-top: 9px;
    padding-bottom: 9px;
    white-space: normal;
}


/* ============================================================
 * 规则应用页中的 Profile 白名单分组
 * ============================================================ */

.white-list-profile-group {
    margin-bottom: 12px;
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(79, 139, 215);
    border-right-color: rgb(65, 74, 84);
    border-top-color: rgb(65, 74, 84);
    border-bottom-color: rgb(65, 74, 84);
    border-radius: 6px;
    background-color: rgb(32, 37, 42);
}

.white-list-profile-header {
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 5px;
    background-color: rgb(41, 46, 52);
}

.white-list-profile-title-container {
    flex-grow: 1;
    min-width: 0;
}

.white-list-profile-display-name {
    color: rgb(240, 243, 246);
    font-size: 14px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.white-list-profile-asset-name {
    margin-top: 2px;
    color: rgb(146, 156, 167);
    font-size: 12px;
    white-space: nowrap;
