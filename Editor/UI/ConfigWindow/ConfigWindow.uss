    border-top-width: 1px;
    border-top-color: rgb(54, 61, 69);
}

/* ============================================================
 * 字段提示与校验
 * ============================================================ */

.field-hint {
    margin-top: 6px;
    margin-bottom: 10px;
    color: rgb(128, 139, 150);
    font-size: 12px;
    white-space: normal;
}

.required-field-hint {
    color: rgb(185, 154, 98);
}

.validation-error-field {
    border-left-width: 2px;
    border-left-color: rgb(210, 74, 74);
    background-color: rgba(140, 45, 45, 0.10);
}

.validation-warning-field {
    border-left-width: 2px;
    border-left-color: rgb(202, 157, 74);
    background-color: rgba(160, 116, 45, 0.10);
}

.validation-error-badge {
    min-height: 24px;
    margin-left: 8px;
    padding-left: 9px;
    padding-right: 9px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(165, 77, 84);
    border-right-color: rgb(165, 77, 84);
    border-top-color: rgb(165, 77, 84);
    border-bottom-color: rgb(165, 77, 84);
    border-radius: 12px;
    background-color: rgb(82, 40, 45);
    color: rgb(255, 170, 170);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* ============================================================
 * 独立 UXML 弹窗
 * ============================================================ */

.dialog-host,
.dialog-template-instance,
.dialog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.dialog-overlay {
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.66);
}

.dialog-panel {
    width: 760px;
    min-width: 460px;
    max-width: 92%;
    max-height: 86%;
    flex-direction: column;
    flex-shrink: 1;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(89, 99, 110);
    border-right-color: rgb(89, 99, 110);
    border-top-color: rgb(89, 99, 110);
    border-bottom-color: rgb(89, 99, 110);
    border-radius: 7px;
    background-color: rgb(35, 39, 44);
}

.dialog-header {
    height: 52px;
    min-height: 52px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 68, 77);
    background-color: rgb(45, 50, 56);
}

.dialog-title {
    min-width: 0;
    flex-grow: 1;
    color: rgb(241, 244, 247);
    font-size: 17px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.dialog-body {
    min-width: 0;
    min-height: 0;
    flex-shrink: 1;
    padding: 16px;
}

.dialog-footer {
    height: 58px;
    min-height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: 12px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: rgb(60, 68, 77);
    background-color: rgb(40, 45, 51);
}

.create-config-dialog-panel > .modal-panel-surface,
.create-checker-dialog-panel > .modal-panel-surface {
    width: 760px;
}

.item-create-dialog-panel > .modal-panel-surface {
    width: 980px;
    height: 620px;
    min-height: 420px;
}

.selection-dialog-panel > .modal-panel-surface {
    width: 760px;
    height: 620px;
    min-height: 420px;
}

.edit-rule-config-dialog-panel > .modal-panel-surface {
    width: 980px;
    height: 760px;
    min-height: 520px;
}

.edit-rule-config-dialog-content {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-direction: column;
}

.edit-rule-config-summary {
    min-height: 64px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 68, 77);
    background-color: rgb(40, 45, 51);
}

.edit-rule-config-summary-main {
    min-width: 0;
    flex-grow: 1;
    margin-left: 10px;
}

.edit-rule-config-summary-name {
    color: rgb(240, 243, 246);
    font-size: 15px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.edit-rule-config-summary-metadata {
    margin-top: 3px;
    color: rgb(146, 156, 167);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.edit-rule-config-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.edit-rule-config-fields {
    min-width: 0;
    flex-shrink: 0;
    padding: 16px;
}

/* ============================================================
 * 弹窗表单布局
 * ============================================================ */

.dialog-form {
    min-width: 0;
    flex-shrink: 0;
}

.dialog-field-row {
    min-width: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 17px;
}

.dialog-field-label {
    width: auto;
    min-width: 0;
    flex-shrink: 0;
    padding-top: 0;
    padding-right: 0;
    margin-bottom: 7px;
    color: rgb(232, 237, 242);
    font-size: 14px;
    -unity-text-align: upper-left;
}

.dialog-field-content {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-self: stretch;
}

.dialog-form > .dialog-field-row:last-child,
.dialog-form > .path-input-field:last-child {
    margin-bottom: 0;
}

.dialog-field-content > .field-hint {
    margin-bottom: 0;
    line-height: 18px;
}

.dialog-control {
    min-width: 0;
    min-height: 34px;
    flex-shrink: 0;
    align-self: stretch;
}

.create-config-id-input {
    position: relative;
    min-width: 0;
    min-height: 34px;
    align-self: stretch;
}

.create-config-id-input > .dialog-control {
    flex-grow: 1;
}

.create-config-id-placeholder {
    position: absolute;
    top: 8px;
    left: 11px;
    color: rgb(128, 139, 150);
    font-size: 14px;
}

.dialog-control .unity-base-field__input,
.dialog-control .unity-base-text-field__input,
.dialog-control .unity-text-field__input,
.selection-search-field .unity-base-text-field__input,
.selection-search-field .unity-text-field__input {
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 73, 82);
    border-right-color: rgb(65, 73, 82);
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
    border-radius: 5px;
    background-color: rgb(23, 26, 30);
    color: rgb(237, 241, 245);
}

.dialog-multiline-control {
    min-height: 84px;
}

.dialog-toggle-control {
    min-height: 22px;
    align-self: flex-start;
}

.dialog-control-line {
    min-width: 0;
    min-height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    align-self: stretch;
}

.dialog-control-line > .dialog-control {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.dialog-control-line > .small-button {
    min-width: 74px;
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 0;
}

.dialog-reference-container {
    min-width: 0;
    min-height: 24px;
    flex-shrink: 0;
    align-self: stretch;
}

.dialog-reference-list {
    min-width: 0;
    min-height: 40px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 73, 82);
    border-right-color: rgb(65, 73, 82);
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
    border-radius: 5px;
    background-color: rgb(25, 28, 32);
}

.dialog-reference-chip-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.dialog-reference-row {
    min-width: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.dialog-reference-row > .object-reference-display {
    width: 0;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.dialog-reference-row > .small-button {
    min-width: 58px;
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 0;
}

.dialog-reference-list > .small-button {
    align-self: flex-start;
    margin-top: 5px;
    margin-right: 0;
}

.dialog-preview-placeholder {
    min-height: 30px;
    color: rgb(142, 153, 164);
    font-size: 12px;
    -unity-font-style: italic;
    -unity-text-align: middle-left;
}

.item-create-dialog-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.item-create-form-container {
    min-width: 0;
    flex-shrink: 0;
    padding: 16px;
}

/* ============================================================
 * 选择配置弹窗
 * ============================================================ */

.selection-dialog-body {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
}

.selection-search-row {
    min-width: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.selection-search-label {
    width: 60px;
    min-width: 60px;
    flex-shrink: 0;
    padding-right: 10px;
    color: rgb(232, 237, 242);
}

.selection-search-field {
    min-width: 0;
    min-height: 34px;
    flex-grow: 1;
    flex-shrink: 1;
}

.selection-list-scroll {
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
}

.selection-list-container {
    min-width: 0;
    flex-grow: 1;
}

.selection-row {
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 54, 61);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(233, 238, 243);
    -unity-text-align: middle-left;
}

.selection-row:hover {
    background-color: rgb(36, 42, 48);
}

.selection-row-selected {
    background-color: rgb(38, 56, 79);
}

.selection-row-text {
    min-width: 0;
    flex-grow: 1;
}

.selection-row-display-name {
    color: rgb(233, 238, 243);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.selection-row-asset-name {
    margin-top: 3px;
    color: rgb(142, 153, 164);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.selection-row-state {
    width: 60px;
    min-width: 60px;
    color: rgb(141, 189, 240);
    font-size: 12px;
    -unity-text-align: middle-right;
}
