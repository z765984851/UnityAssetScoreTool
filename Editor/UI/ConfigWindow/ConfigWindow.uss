    padding: 8px;
    color: rgb(255, 210, 139);
    background-color: rgba(157, 96, 38, 0.12);
    white-space: normal;
}

/* ---------- 状态 ---------- */

.status-success,
.status-warning,
.status-error,
.status-info {
    min-height: 24px;
    min-width: 0;
    margin-left: 8px;
    padding-left: 9px;
    padding-right: 9px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 12px;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.status-success {
    color: rgb(131, 215, 163);
    border-left-color: rgb(57, 119, 85);
    border-right-color: rgb(57, 119, 85);
    border-top-color: rgb(57, 119, 85);
    border-bottom-color: rgb(57, 119, 85);
    background-color: rgb(32, 58, 42);
}

.status-warning {
    color: rgb(232, 189, 107);
    border-left-color: rgb(138, 102, 45);
    border-right-color: rgb(138, 102, 45);
    border-top-color: rgb(138, 102, 45);
    border-bottom-color: rgb(138, 102, 45);
    background-color: rgb(70, 54, 31);
}

.status-error {
    color: rgb(255, 170, 170);
    border-left-color: rgb(165, 77, 84);
    border-right-color: rgb(165, 77, 84);
    border-top-color: rgb(165, 77, 84);
    border-bottom-color: rgb(165, 77, 84);
    background-color: rgb(82, 40, 45);
}

.status-info {
    color: rgb(184, 216, 255);
    border-left-color: rgb(63, 99, 142);
    border-right-color: rgb(63, 99, 142);
    border-top-color: rgb(63, 99, 142);
    border-bottom-color: rgb(63, 99, 142);
    background-color: rgb(37, 59, 82);
}

/* ---------- DisplayName 优先的对象引用 ---------- */

.reference-form-row {
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.reference-form-label {
    width: 140px;
    min-width: 140px;
    margin-right: 12px;
    color: rgb(215, 221, 228);
    font-size: 14px;
}

.object-reference-display {
    min-height: 48px;
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 73, 82);
    border-right-color: rgb(65, 73, 82);
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
    border-radius: 5px;
    background-color: rgb(25, 28, 32);
}

.object-reference-icon {
    width: 18px;
    min-width: 18px;
    margin-right: 6px;
    color: rgb(143, 196, 241);
}

.object-reference-text {
    flex-grow: 1;
    min-width: 0;
}

.object-reference-display-name {
    color: rgb(238, 242, 246);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.object-reference-asset-name {
    margin-top: 2px;
    color: rgb(146, 156, 167);
    font-size: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* ---------- AssetType / Profile 数组 ---------- */

.reference-array-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    margin-top: -5px;
}

/* ---------- 白名单地址输入 ---------- */

.white-list-path-row {
    min-width: 0;
    align-items: center;
}

.white-list-path-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.white-list-path-field {
    width: auto;
    min-width: 0;
    min-height: 34px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    margin-right: 6px;
}

.white-list-path-field > .unity-base-field__input,
.white-list-path-field .unity-base-field__input,
.white-list-path-field > .unity-base-text-field__input,
.white-list-path-field .unity-base-text-field__input,
.white-list-path-field > .unity-text-field__input,
