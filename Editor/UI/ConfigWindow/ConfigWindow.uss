}

.config-property-field .unity-base-field__input,
.config-text-field .unity-base-text-field__input,
.config-text-field .unity-text-field__input,
.multiline-text-field .unity-base-text-field__input,
.multiline-text-field .unity-text-field__input {
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 73, 82);
    border-right-color: rgb(65, 73, 82);
    border-top-color: rgb(65, 73, 82);
    border-bottom-color: rgb(65, 73, 82);
    border-radius: 5px;
    background-color: rgb(23, 26, 30);
    color: rgb(237, 241, 245);
}

.config-text-field,
.multiline-text-field {
