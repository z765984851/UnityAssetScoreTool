<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="True">

    <Style src="../ConfigWindow.uss"/>

    <ui:VisualElement class="create-checker-dialog-content">
        <ui:VisualElement class="dialog-body dialog-form">
            <ui:VisualElement class="dialog-field-row">
                <ui:Label text="类名 *"
                          class="dialog-field-label"/>
                <ui:VisualElement class="dialog-field-content">
                    <ui:TextField name="CheckerClassNameField"
                                  class="dialog-control"/>
                    <ui:Label text="必填。默认根据当前规则 ID 生成 C# 类名。"
                              class="field-hint required-field-hint"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="CheckerSaveFolderContainer"
                              class="dialog-field-content"/>
        </ui:VisualElement>

        <ui:VisualElement class="dialog-footer">
            <ui:Button name="CreateCheckerCancelButton"
                       text="取消"
                       class="tool-button"/>
            <ui:Button name="CreateCheckerConfirmButton"
                       text="创建并打开脚本"
                       class="tool-button primary-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
