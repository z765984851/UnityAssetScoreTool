<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         engine="UnityEngine.UIElements"
         editor="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="True">

    <Style src="Common.uss"/>

    <ui:VisualElement name="ValidationMessageRoot"
                      class="validation-message-view">
        <ui:VisualElement class="validation-message-header">
            <ui:Label text="!"
                      class="validation-message-icon"/>
            <ui:Label name="ValidationMessageTitle"
                      text="配置存在问题"
                      class="validation-message-title"/>
            <ui:Label name="ValidationMessageCount"
                      class="validation-message-count"/>
        </ui:VisualElement>

        <ui:VisualElement name="ValidationMessageList"
                          class="validation-message-list"/>
    </ui:VisualElement>
</ui:UXML>
