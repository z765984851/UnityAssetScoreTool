  ruleId: basic.texture.mipmap
  displayName: "Texture(贴图)已启用MipMap(多级渐远纹理)"
  description: "检查Texture(贴图)是否启用MipMap(多级渐远纹理)。"
  priority: 0
  issueInfos:
  - issueInfoId: isopen
    displayName: "Texture(贴图)已启用MipMap(多级渐远纹理)"
    deductScore: 5
    issueLevel: 1
    issueMessage: "UI(User Interface，用户界面) Texture(贴图)启用MipMap(多级渐远纹理)通常没有收益，并会增加额外内存；在Web平台上还可能造成显示模糊。建议：关闭不需要的MipMap。"
